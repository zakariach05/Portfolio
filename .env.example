# ═══════════════════════════════════════════════════════════
#  Copier ce fichier vers `.env.local` et remplir les valeurs.
#  Le fichier .env.local est gitignoré (ne jamais committer de clé).
# ═══════════════════════════════════════════════════════════

# ── Formulaire de contact (route /api/contact, service Resend) ──
RESEND_API_KEY=re_exemple_replacer_par_ta_cle

# ── Cloudinary (migration images, OPTIONNEL) ──
# Tant que vide : les composants AppImage retombent sur next/image.
# Remplir puis re-uploader avec :
#   node scripts/upload-cloudinary.mjs
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Pour l'upload script uniquement (API key/secret depuis Cloudinary Dashboard):
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Vidéo hero (CDN, OPTIONNEL) ──
# Si vide : la vidéo est servie depuis le serveur d'origine (public/NV-IMG/vidio).
# Remplir avec l'URL de base du CDN (Cloudflare Stream / Bunny CDN / Cloudinary)
# qui héberge : hero-video-mobile.webm + video_preview_h264.mp4.
# Exemple : NEXT_PUBLIC_HERO_VIDEO_CDN=https://assets.example.com/nv-hero
NEXT_PUBLIC_HERO_VIDEO_CDN=